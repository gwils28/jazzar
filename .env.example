# ---- Jazzar : copier en .env et adapter ----

# Clé API Anthropic (https://platform.claude.com). Sans clé, Jazzar fonctionne en mode
# dégradé : recherche par mots-clés et vectorielle, sans synthèse ni agents.
ANTHROPIC_API_KEY=

# Modèles Claude
JAZZAR_MODEL_LARGE=claude-opus-5-5
JAZZAR_MODEL_SMALL=claude-haiku-5-5

# Base de données (docker compose expose Postgres sur 5433 pour ne pas gêner d'autres projets)
JAZZAR_DATABASE_URL=postgresql+asyncpg://jazzar:jazzar@localhost:5433/jazzar
JAZZAR_DATABASE_RO_URL=postgresql+asyncpg://jazzar_ro:jazzar_ro@localhost:5433/jazzar
JAZZAR_REDIS_URL=redis://localhost:6379/0

# Embeddings locaux (bge-m3 : multilingue FR/EN, 1024 dimensions)
JAZZAR_EMBEDDING_MODEL=BAAI/bge-m3
JAZZAR_EMBEDDING_DEVICE=auto   # auto | cuda | cpu

# Dossiers de données
JAZZAR_DATA_DIR=../data

# Cache sémantique : seuil de similarité cosinus pour servir une réponse en cache
JAZZAR_SEMANTIC_CACHE_THRESHOLD=0.95
JAZZAR_SEMANTIC_CACHE_TTL=86400

# API
JAZZAR_API_HOST=0.0.0.0
JAZZAR_API_PORT=8100
JAZZAR_CORS_ORIGINS=http://localhost:3000

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8100
